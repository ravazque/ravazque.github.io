# Secrets: only .env.example is committed
.env
web/certs/*
!web/certs/.gitkeep

# Local tools and their data (other students' data) are never published
report-tool/
.venv/

# The evaluation report's extractions and pages name other students
tools/evaluation-report/data/
tools/evaluation-report/out/

# Generated
web/Caddyfile.local
web/preview/
site/_build/
_site/
__pycache__/
*.pyc
.pytest_cache/
node_modules/

# Editors and desktop files
.directory
.vscode/
.idea/
*.swp
*.egg-info/
# The first version (Python) stays on the owner's machine
.v1_old/
server/internal/web/dist/*
!server/internal/web/dist/.gitkeep
web/dist-offline/
