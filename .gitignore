# Secrets: only .env.example is committed
.env
web/certs/*
!web/certs/.gitkeep

# Local tools and their data (other students' data) are never published
report-tool/
.venv/

# Generated
web/Caddyfile.local
web/preview/
site/_build/
_site/
__pycache__/
*.pyc
.pytest_cache/
node_modules/

# Editors and desktop files
.directory
.vscode/
.idea/
*.swp
*.egg-info/
# v1_old/: the first version (Python), archived as it was on GitHub at bd7e5d4; its local parts stay out
v1_old/report-tool/
v1_old/.golden/
server/internal/web/dist/*
!server/internal/web/dist/.gitkeep
web/dist-offline/
