# Configuration of the web app, read by docker compose.
# Copy it to .env (make does it for you) and fill the empty values. Never commit .env.

# 42 applications (https://profile.intra.42.fr/oauth/applications), scope public. App-token requests are spread over all three.
# The one that signs users in, in production and in dev. Redirect URIs (one per line): https://ravazque.info/auth/callback
# and https://localhost/auth/callback · Website https://ravazque.info
FT_UID=
FT_SECRET=
# Never signs anyone in (its redirect URI is never used): more request budget only
FT_UID_2=
FT_SECRET_2=
# Never signs anyone in (its redirect URI is never used): more request budget only
FT_UID_3=
FT_SECRET_3=

# Web: a random secret (openssl rand -hex 32). make dev always runs at https://localhost and make production at https://ravazque.info
SESSION_SECRET=
# <description>
BASE_URL=
# make production: the token of the Cloudflare tunnel that serves ravazque.info (Zero Trust > Networks > Tunnels)
TUNNEL_TOKEN=
# The privacy policy names the data controller and the contact for data requests
CONTROLLER_NAME=
CONTACT_EMAIL=
REPORT_LOGIN=
# make dev-real: the 42 logins (comma-separated) whose real reports dev serves at once beside the test profiles (local only)
DEV_REAL_LOGINS=
# Students who asked to be excluded, comma-separated logins: shown as "Hidden" in every report
OPTOUT_LOGINS=
# Optional "Report an issue" link, e.g. https://github.com/<owner>/<repo>/issues/new/choose
ISSUES_URL=

# Publishing the public snapshot to a GitHub Pages repository (optional: hidden while OWNER_LOGIN or GITHUB_TOKEN is empty)
# Token: github.com/settings/personal-access-tokens · fine-grained · only this repository · Contents: Read and write
OWNER_LOGIN=
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
